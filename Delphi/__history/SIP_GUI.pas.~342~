begin
  FileOpenDialog := TFileOpenDialog.Create(nil);
  try
    FileOpenDialog.Options := [fdoPickFolders, fdoPathMustExist];
    FileOpenDialog.Title := 'Select a Folder';
    FileOpenDialog.DefaultFolder := sUserPath;

