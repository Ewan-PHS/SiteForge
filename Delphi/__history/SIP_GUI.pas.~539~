procedure TfrmMain.SaveSettings(sSpecificSection: String = ''; sSpecificIdent: String = ''; sSpecificValue: String = '');
var
  Ini: TIniFile;
  bSaved: Boolean;
  sGcodeText: String;
begin
  bSaved := True;
  Ini := TIniFile.Create(ChangeFileExt(sSiteForgePath, '\config\slicerConfig.ini'));
  try
    try

      if (sSpecificSection <> '') and (sSpecificIdent <> '') and (sSpecificValue <> '') then
      begin
        if LowerCase(sSpecificValue[1])[1] in ['a'..'z'] then
          Ini.WriteString(sSpecificSection, sSpecificIdent, sSpecificValue)
        else if (sSpecificValue[1] in ['0'..'9']) or (sSpecificValue[1] in ['-']) then
          Ini.WriteFloat(sSpecificSection, sSpecificIdent, StrToFloat(sSpecificValue));
      end;


    // Print
      // Layers
      // Speed
      // Advanced

    // Material
      // General
      Ini.WriteFloat('DEFAULT', 'temperature', nobxNozzleTemp.Value);
      Ini.WriteFloat('DEFAULT', 'first_layer_temperature', nobxFLayerNozzleTemp.Value);
      Ini.WriteFloat('DEFAULT', 'bed_temperature', nobxBedTemp.Value);
      Ini.WriteFloat('DEFAULT', 'first_layer_bed_temperature', nobxFLayerBedTemp.Value);
      // Advanced

    // Printer
      // General
      Ini.WriteString('DEFAULT', 'bed_shape', ('0x0,' +
      FloatToStr(nobxBedShapeX.Value) + 'x0,' +
      FloatToStr(nobxBedShapeX.Value) + 'x' +
      FloatToStr(nobxBedShapeY.Value) + ',0x' +
      FloatToStr(nobxBedShapeY.Value) + ''));

      Ini.WriteFloat('DEFAULT', 'z_offset', nobxZOffset.Value);
      // Custom Gcode
      sGcodeText := memPrinterGcodeStart.Text;
      sGcodeText := StringReplace(sGcodeText, #13#10, '\n', [rfReplaceAll]);
      Ini.WriteString('DEFAULT', 'start_gcode', sGcodeText);

      sGcodeText := memPrinterGcodeEnd.Text;
      sGcodeText := StringReplace(sGcodeText, #13#10, '\n', [rfReplaceAll]);
      Ini.WriteString('DEFAULT', 'end_gcode', sGcodeText);

      sGcodeText := memPrinterGcodeBeforeLayerChange.Text;
      sGcodeText := StringReplace(sGcodeText, #13#10, '\n', [rfReplaceAll]);
      Ini.WriteString('DEFAULT', 'before_layer_gcode', sGcodeText);

      sGcodeText := memPrinterGcodeAfterLayerChange.Text;
      sGcodeText := StringReplace(sGcodeText, #13#10, '\n', [rfReplaceAll]);
      Ini.WriteString('DEFAULT', 'layer_gcode', sGcodeText);
      // Extruder
      Ini.WriteFloat('DEFAULT', 'nozzle_diameter', nobxNozzleDiameter.Value);
      Ini.WriteFloat('DEFAULT', 'retract_length', nobxRetractionLength.Value);
      Ini.WriteFloat('DEFAULT', 'retract_speed', nobxRetractionSpeed.Value);

    // Preferences
      Ini.WriteInteger('DEFAULT', 'threads', Round(nobxNumberThreads.Value));
      Ini.WriteBool('SITEFORGE', 'auto_count_threads', chkbxAutoCountThreads.Checked);

    except
      on E: Exception do
      begin
        bSaved := False;
        ShowMessage('There was an error when saving your settings.');
      end;
    end;
  finally
    Ini.Free;
  end;

  if bSaved then
    ShowMessage('Settings saved successfully.');
end;

