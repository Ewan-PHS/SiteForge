  sUserPath := TPath.GetDownloadsPath;

  sInstalledPath := TPath.GetAppPath;

  redtSavePathDisplay.Text := '';
  redtGcodeSavePathDisplay.Text := '';

  pgctrlMain.TabIndex := 0;
  pgctrlSettings.TabIndex := 0;
  pgctrlPrintSettings.TabIndex := 0;
  pgctrlMaterialSettings.TabIndex := 0;
  pgctrlPrinterSettings.TabIndex := 0;

  bLoadSettings := True;
  bResetupIni := True;

  memPrinterGcodeStart.Text := '';
  memPrinterGcodeEnd.Text := '';
  memPrinterGcodeBeforeLayerChange.Text := '';
  memPrinterGcodeAfterLayerChange.Text := '';

end;

procedure TfrmMain.tmr10msTimer(Sender: TObject);
begin
  sName := edtName.Text;

  if (sImgPathRightView <> '') and (sImgPathTopView <> '') and (sImgPathFrontView <> '') and (sSavePath <> '') and (edtName.Text <> '') then
    btnGenerate.Enabled := True
  else
    btnGenerate.Enabled := False;


  if bGeneratedSuccessfully and (sGcodeSavePath <> '') then
    btnSliceExport.Enabled := True
  else
    btnSliceExport.Enabled := False;

  if chkbxAutoCountThreads.Checked and (nobxNumberThreads.Value <> System.CPUCount) then
  begin
    nobxNumberThreads.Value := System.CPUCount;
    SaveSettings();
  end;

end;

