procedure TfrmMain.SetupIniForEditing();
var
  sLoadedIniFile: String;
begin
  sLoadedIniFile := TFile.ReadAllText(sSiteForgePath + '\config\slicerConfig.ini');

  if sLoadedIniFile[1] <> '[' then
    sLoadedIniFile := '[DEFAULT]' + sLoadedIniFile;

  TFile.WriteAllText(sSiteForgePath + '\config\slicerConfig.ini', sLoadedIniFile);
end;

procedure TfrmMain.SetupIniForSlicing();
var
  sLoadedIniFile: String;
begin
  sLoadedIniFile := TFile.ReadAllText(sSiteForgePath + '\config\slicerConfig.ini');

  if sLoadedIniFile[1] = '[' then
    Delete(sLoadedIniFile, 1, 9);

  TFile.WriteAllText(sSiteForgePath + '\config\slicerConfig.ini', sLoadedIniFile);
end;

function TfrmMain.FormatBedShapeForLoading(sBedShape: String): TArray<Extended>;
var
  iCountComma, iCountCharX: Integer;
  iIndex, jIndex: Integer;
  sBuildingNumber: String;
  bFoundXValue, bFoundYValue: Boolean;
begin
  // Input format: 0x0,Xx0,XxY,0xY
  SetLength(Result, 2);
  iCountComma := 0;
  iCountCharX := 0;
  bFoundXValue := False;
  bFoundYValue := False;

  for iIndex := 1 to Length(sBedShape) do
  begin
    if sBedShape[iIndex] = ',' then
      Inc(iCountComma)
    else if sBedShape[iIndex] = 'x' then
      Inc(iCountCharX);

    if (iCountComma = 1) and (bFoundXValue = False) then
    begin
      sBuildingNumber := '';
      jIndex := iIndex;
      repeat
        Inc(jIndex);
        sBuildingNumber := sBuildingNumber + sBedShape[jIndex];
      until sBedShape[jIndex + 1] = 'x';
      Result[0] := StrToFloat(sBuildingNumber);
      bFoundXValue := True;
    end;

    if (iCountCharX = 3) and (bFoundYValue = False) then
    begin
      sBuildingNumber := '';
      jIndex := iIndex;
      repeat
        Inc(jIndex);
        sBuildingNumber := sBuildingNumber + sBedShape[jIndex];
      until sBedShape[jIndex + 1] = ',';
      Result[1] := StrToFloat(sBuildingNumber);
      bFoundYValue := True;
    end;

  end;
end;

