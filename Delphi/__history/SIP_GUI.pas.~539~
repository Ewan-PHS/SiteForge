procedure TfrmMain.LoadSettings;
var
  Ini: TIniFile;
  sGcodeText: String;
  arrExtended: TArray<Extended>;
begin
  SetLength(arrExtended, 2);

  Ini := TIniFile.Create(ChangeFileExt(sSiteForgePath, '\config\slicerConfig.ini'));
  try
    try
    // Print
      // Layers
      nobxLayerHeight.Value := Ini.ReadFloat('DEFAULT', 'layer_height', 0.2);
      nobxFLayerHeight.Value := Ini.ReadFloat('DEFAULT', 'first_layer_height', 0.15);
      nobxMinLayerHeight.Value := Ini.ReadFloat('DEFAULT', 'min_layer_height', 0.2);
      nobxMaxLayerHeight.Value := Ini.ReadFloat('DEFAULT', 'max_layer_height', 0.3);
      // Speed
      nobxInfillSpeed.Value := Ini.ReadFloat('DEFAULT', 'infill_speed', 80);
      nobxFLayerSpeed.Value := Ini.ReadFloat('DEFAULT', 'first_layer_speed', 30);
      nobxMinPrintSpeed.Value := Ini.ReadFloat('DEFAULT', 'min_print_speed', 10);
      nobxMaxPrintSpeed.Value := Ini.ReadFloat('DEFAULT', 'max_print_speed', 80);
      // Advanced

    // Material
      // General
      nobxNozzleTemp.Value := Ini.ReadFloat('DEFAULT', 'temperature', 200);
      nobxFLayerNozzleTemp.Value := Ini.ReadFloat('DEFAULT', 'first_layer_temperature', 210);
      nobxBedTemp.Value := Ini.ReadFloat('DEFAULT', 'bed_temperature', 60);
      nobxFLayerBedTemp.Value := Ini.ReadFloat('DEFAULT', 'first_layer_bed_temperature', 65);
      // Advanced

    // Printer
      // General
      arrExtended := FormatBedShapeForLoading(Ini.ReadString('DEFAULT', 'bed_shape', ''));
      nobxBedShapeX.Value := arrExtended[0];
      nobxBedShapeY.Value := arrExtended[1];

      nobxZOffset.Value := Ini.ReadFloat('DEFAULT', 'z_offset', 0);
      // Custom Gcode
      sGcodeText := Ini.ReadString('DEFAULT', 'start_gcode', 'G28');
      sGcodeText := StringReplace(sGcodeText, '\n', #13#10, [rfReplaceAll]);
      memPrinterGcodeStart.Text := sGcodeText;

      sGcodeText := Ini.ReadString('DEFAULT', 'end_gcode', 'M104 S0');
      sGcodeText := StringReplace(sGcodeText, '\n', #13#10, [rfReplaceAll]);
      memPrinterGcodeEnd.Text := sGcodeText;

      sGcodeText := Ini.ReadString('DEFAULT', 'before_layer_gcode', '');
      sGcodeText := StringReplace(sGcodeText, '\n', #13#10, [rfReplaceAll]);
      memPrinterGcodeBeforeLayerChange.Text := sGcodeText;

      sGcodeText := Ini.ReadString('DEFAULT', 'layer_gcode', '');
      sGcodeText := StringReplace(sGcodeText, '\n', #13#10, [rfReplaceAll]);
      memPrinterGcodeAfterLayerChange.Text := sGcodeText;
      // Extruder
      nobxNozzleDiameter.Value := Ini.ReadFloat('DEFAULT', 'nozzle_diameter', 0.4);
      nobxRetractionLength.Value := Ini.ReadFloat('DEFAULT', 'retract_length', 2);
      nobxRetractionSpeed.Value := Ini.ReadFloat('DEFAULT', 'retract_speed', 40);

    // Preferences
      nobxNumberThreads.Value := Ini.ReadInteger('DEFAULT', 'threads', 4);
      chkbxAutoCountThreads.Checked := Ini.ReadBool('SITEFORGE', 'auto_count_threads', True);

    except
      on E: Exception do
      begin
        ShowMessage('There was an error when loading your settings.');
      end;
    end;
  finally
    Ini.Free;
  end;
end;

